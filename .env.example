# Environment Configuration Example for NIFTY Multi-Strategy Bot
# Copy this file to .env for local overrides (never commit .env)

# Feed Connection Settings (ZeroMQ SUB)
FEED_ZMQ_URL=tcp://127.0.0.1:5555
FEED_TOPIC=NIFTY_MARKET_TICK
FEED_TIMEOUT_MS=500

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Permanent Paper Trading Boundary (MUST REMAIN TRUE)
PAPER_TRADING_ONLY=true
BROKER_LIVE_EXECUTION_ENABLED=false

# Web Dashboard (Optional)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
